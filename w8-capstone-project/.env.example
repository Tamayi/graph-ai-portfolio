# Copy to .env and fill in. Never commit .env.

# Anthropic API key from https://console.anthropic.com/settings/keys
# Must be an API key (sk-ant-api03-...), not an OAuth token (sk-ant-oat01-...).
ANTHROPIC_API_KEY=sk-ant-api03-...

# Voyage AI key from https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=pa-...

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
VOYAGE_MODEL=voyage-4
CHROMA_DIR=./data/chroma
# Hold out the N most recent reports as a test set (0 = disabled)
# HOLDOUT_RECENT_N=0
